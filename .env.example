# Örnek değişkenler: gerçek şifre veya anahtar eklemeyin.
NODE_ENV=development
PORT=3000

# MySQL bağlantısı (yerel geliştirme için örnek)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=visitor_vehicle_management
DB_USER=change_me
DB_PASSWORD=change_me

# Daha sonra kullanılacak örnek uygulama değişkenleri
JWT_SECRET=replace_with_strong_local_secret
CLIENT_ORIGIN=http://localhost:5173
